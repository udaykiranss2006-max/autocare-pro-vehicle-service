{"name":"Login (saves token)","event":[{"listen":"test","script":{"exec":["pm.collectionVariables.set('token', pm.response.json().data.accessToken)"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/login","body":{"mode":"raw","raw":"{\"email\":\"test@example.com\",\"password\":\"Str0ng!Pass\"}"}}},
{"name":"Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base}}/auth/me"}},

# ---------------------------------------------------------------
# AutoCare Pro backend configuration. Copy to .env and edit.
# NEVER commit your real .env file.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime when "Remember me" is ticked (days)
REFRESH_TOKEN_DAYS=7
# Refresh-token lifetime without "Remember me" (hours)
SESSION_REFRESH_HOURS=12
# Set to true when serving over HTTPS (always true in production)
COOKIE_SECURE=false

BCRYPT_ROUNDS=12
DATA_DIR=./data

# Development only: print password-reset links to the server console
# because email delivery is not configured. Must be false in production.
DEV_SHOW_RESET_LINK=true

# How often (minutes) the in-app reminder job runs
REMINDER_INTERVAL_MINUTES=60

# ---------- Seed script (npm run seed) ----------
# Initial administrator. Password must be strong (8+ chars, upper, lower, digit, symbol).
# The admin is forced to change it at first login.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@autocarepro.local
SEED_ADMIN_PASSWORD=

# Optional demo staff + demo customer (leave password blank to skip creating them)
SEED_DEMO_PASSWORD=

# ---------- Optional integrations (not required) ----------
# Email/SMS delivery is NOT implemented out of the box. Notifications are in-app.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# SMS_API_KEY=
